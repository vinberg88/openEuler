[Unit]
Description=Kiran Desktop on X410
After=dbus.service pipewire.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%t/kiran-x410.env
ExecStart=/usr/local/libexec/kiran-x410-session
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=12

[Install]
WantedBy=default.target
