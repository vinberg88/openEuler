#!/usr/bin/env bash
set -Eeuo pipefail

unset WAYLAND_DISPLAY
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KIRAN
export XDG_SESSION_DESKTOP=kiran
export DESKTOP_SESSION=kiran
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export SDL_VIDEODRIVER=x11
export NO_AT_BRIDGE=1
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/kiran-x410"
mkdir -p "$log_dir"
exec >>"$log_dir/session.log" 2>&1

printf '\n===== %s =====\n' "$(date --iso-8601=seconds)"
echo "Kiran X11-session startar: user=$(id -un) display=${DISPLAY:-saknas}"
timeout 5 xdpyinfo -display "${DISPLAY:?DISPLAY saknas}" >/dev/null

exec /usr/bin/kiran-session-manager --session-type=kiran
